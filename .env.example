API_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
SITE_ADDRESS=http://localhost
# Production: SITE_ADDRESS=research.example.com, public DNS and ports 80/443 required.
# Local Python only; Docker overrides this path.
DATABASE_PATH=data/research.sqlite3
AUTO_SYNC=1
# AUTO_SYNC=0 disables scheduled crawling on startup. Manual Sync enables it again.

# ---------- Optional OpenAI-compatible advisor ----------
# Disabled unless OPENAI_API_KEY is set. Any OpenAI-compatible /chat/completions
# server works: OpenAI, Azure-style gateways, Ollama (/v1), LM Studio, vLLM, LiteLLM.
# The advisor can only nudge the statistical ensemble within +/-OPENAI_MAX_TILT;
# it never replaces the model, and lottery draws stay random.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_MAX_TILT=0.25
# OPENAI_TIMEOUT=45
#   Reasoning models and gateway-served models can take 20-30s for a full
#   55-number advisory payload. A lower timeout makes every call fail silently.
# OPENAI_ENABLED=auto
#   auto  = on as soon as OPENAI_API_KEY is set (default)
#   1     = force on
#   0     = force off, even with a key present -- do not copy this line if you
#           want the advisor active
# OPENAI_JSON_MODE=1
# OPENAI_TEMPERATURE=0
